# Server-only webhook that the contact form proxy (/api/contact) forwards
# submissions to. This is read only on the server — do NOT prefix it with
# NEXT_PUBLIC_, or it would be inlined into the client bundle.
#
# Copy this file to .env.local for local development, and set the same variable
# in your hosting provider's environment settings for production.
N8N_EMAIL_WEBHOOK_URL=https://your-n8n-domain.com/webhook/your-webhook-id
